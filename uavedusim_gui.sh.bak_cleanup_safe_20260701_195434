        "INFO  [gz_bridge]",
    ]

    last_ready = -1
    matched = ""
    for marker in ready_markers:
        idx = data.rfind(marker)
        if idx > last_ready:
            last_ready = idx
            matched = marker

    if last_ready >= 0 and last_ready > last_failure:
        return True, f"log: {matched}"

