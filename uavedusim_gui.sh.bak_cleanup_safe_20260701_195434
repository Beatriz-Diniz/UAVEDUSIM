    if [ -e "$model_path" ] || [ -L "$model_path" ]; then
        log "Modelo UAVEDUSIM encontrado no PX4: $model_path"
    else
        log "Aviso: modelo UAVEDUSIM nao encontrado no PX4: $model_path"
