<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_uavjamsim — Modelo combinado com todos os sensores do X500 para o UAVJamSim.

  Sensores incluídos:
    ✔ IMU, Magnetômetro, Barômetro, GPS        — herdados do x500_base via x500
    ✔ Motores (rotor_0..3) + MotorFailurePlugin — herdados do x500
    ✔ Vision Odometry (OdometryPublisher)       — gz_x500_vision
    ✔ Airspeed                                  — airspeed_link  (tópico: .../link/airspeed_link/sensor/air_speed/air_speed)
    ✖ Optical Flow                              — desativado neste perfil; VIO permanece ativa
    ✔ 2D LiDAR (lidar_2d_v2)                   — link "link"    (tópico: .../link/link/sensor/lidar_2d_v2/scan)
    ✔ Câmera de profundidade OakD-Lite          — oakd_lite_camera_link (câmera frontal, montada sobre o LiDAR 2D)
    ✔ 1D LiDAR down-facing                     — lidar_down_sensor_link / sensor "lidar_down"  (tópico: .../link/lidar_down_sensor_link/sensor/lidar_down/scan)
    ✔ 1D LiDAR front-facing                    — lidar_front_sensor_link / sensor "lidar_front" (visual + sensor extra; GZBridge roteado via orientação)
    ✔ Gimbal frontal (CGO3)                    — cgo3_mount_link (herdado do model://gimbal)

  Convenção de nomes de link/sensor:
    O GZBridge do UAVJamSim subscreve caminhos FIXOS. Os nomes abaixo devem
    corresponder exatamente ao que está em GZBridge.cpp:

      /link/base_link/sensor/imu_sensor/imu
      /link/base_link/sensor/magnetometer_sensor/magnetometer
      /link/base_link/sensor/air_pressure_sensor/air_pressure
      /link/base_link/sensor/navsat_sensor/navsat
      /model/<name>/odometry_with_covariance
      /link/link/sensor/lidar_2d_v2/scan
      /link/lidar_down_sensor_link/sensor/lidar_down/scan ← 1D LiDAR down-facing
      /link/airspeed_link/sensor/air_speed/air_speed
      # /link/flow_link/sensor/optical_flow/optical_flow  (desativado)
-->
<sdf version='1.9'>
  <model name='x500_uavjamsim'>
    <self_collide>false</self_collide>

    <!-- ================================================================
         BASE: Quadrotor X500
         Inclui: base_link (IMU, Magnetômetro, Barômetro, GPS, colisões,
         visuais da fuselagem), rotores 0-3, MotorFailurePlugin e os 4
         plugins MulticopterMotorModel.
         Airframe de referência: 4001_gz_x500
    ================================================================ -->
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <!-- ================================================================
         VISION ODOMETRY (gz_x500_vision — airframe 4005)
         Publica no tópico /model/<name>/odometry_with_covariance.
         O GZBridge subscreve esse tópico em subscribeOdometry().
    ================================================================ -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

    <!-- ================================================================
         AIRSPEED SENSOR
         Tópico: /link/airspeed_link/sensor/air_speed/air_speed
         Posição: à frente-direita do base_link, fora da esteira dos rotores.
         O visual simula um tubo de Pitot horizontal.
    ================================================================ -->
    <link name="airspeed_link">
      <pose relative_to="base_link">0.24 -0.12 0.06 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="airspeed_visual">
        <!-- Cilindro horizontal simulando o tubo de Pitot -->
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.004</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.0 0.0 0.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <sensor name="air_speed" type="air_speed">
        <gz_frame_id>airspeed_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>5.0</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="airspeed_joint" type="fixed">
      <parent>base_link</parent>
      <child>airspeed_link</child>
    </joint>

    <!-- OPTICAL_FLOW_DISABLED
    <!- - ================================================================
         OPTICAL FLOW SENSOR (gz_x500_vision, sensor óptico down-facing)
         Tópico: /link/flow_link/sensor/optical_flow/optical_flow
         Posição: abaixo do base_link, levemente deslocado para frente,
         apontando para baixo (sem colisão para não interferir no pouso).
    ================================================================ - ->
    <link name="flow_link">
      <pose relative_to="base_link">0.10 0.08 -0.035 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="optical_flow_visual_housing">
        <geometry>
          <box><size>0.034 0.034 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>
      <visual name="optical_flow_visual_lens">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.006</radius><length>0.005</length></cylinder>
        </geometry>
      </visual>
      <!- - Câmera auxiliar usada internamente pelo plugin de optical flow - ->
      <sensor name="flow_camera" type="camera">
        <gz_frame_id>flow_link</gz_frame_id>
        <pose>0 0 0 0 1.5707 0</pose>
        <camera>
          <horizontal_fov>0.733038</horizontal_fov>
          <image><width>100</width><height>100</height></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
      </sensor>
      <!- - Sensor de fluxo óptico customizado do Gazebo - ->
      <sensor name="optical_flow" type="custom" gz:type="optical_flow">
        <gz_frame_id>flow_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
    </joint>

    -->

    <!-- ================================================================
         2D LiDAR — lidar_2d_v2 (gz_x500_lidar_2d — airframe 4013)
         Tópico: /link/link/sensor/lidar_2d_v2/scan
         O nome do link DEVE ser "link" (herdado do modelo lidar_2d_v2).
         Montado no topo do drone (z=0.26 m acima do base_link).
    ================================================================ -->
    <include merge='true'>
      <uri>model://lidar_2d_v2</uri>
      <pose>.12 0 .26 0 0 0</pose>
    </include>
    <joint name="Lidar2DJoint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
      <pose relative_to="base_link">-.1 0 .26 0 0 0</pose>
    </joint>

    <!-- ================================================================
         CÂMERA DE PROFUNDIDADE OakD-Lite (gz_x500_depth — airframe 4002)
         Tópico sensor: .../link/oakd_lite_camera_link/sensor/IMX214/...
                        .../link/oakd_lite_camera_link/sensor/StereoOV7251/...
         Montada sobre o LiDAR 2D (parent: link) para evitar visual flutuante.
         O pequeno deslocamento em Y (+0.03 m) centraliza o mesh OakD-Lite
         no topo do LiDAR.
    ================================================================ -->
    <link name="oakd_lite_camera_link">
      <pose relative_to="link">0 0.03 0.090 0 0 0</pose>
      <inertial>
        <pose>0.00358 -0.03 .014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000055421</iyy><iyz>0</iyz>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="oakd_lite_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://OakD-Lite/meshes/OakDLite.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Câmera RGB 12 MP (IMX214) -->
      <sensor name="IMX214" type="camera">
        <gz_frame_id>oakd_lite_camera_link</gz_frame_id>
        <pose>0.01233 -0.03 .01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>1920</width><height>1080</height></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <!-- Câmera de profundidade estéreo (OV7251) -->
      <sensor name="StereoOV7251" type="depth_camera">
        <gz_frame_id>oakd_lite_camera_link</gz_frame_id>
        <pose>0.01233 -0.03 .01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width><height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip><near>0.2</near><far>19.1</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="OakDLiteJoint" type="fixed">
      <parent>link</parent>
      <child>oakd_lite_camera_link</child>
    </joint>

    <!-- ================================================================
         1D LiDAR — DOWN-FACING (gz_x500_lidar_down — airframe 4016)
         Tópico: /link/lidar_sensor_link/sensor/lidar/scan  ← NOME FIXO DO GZBridge
         O GZBridge detecta a orientação pelo quaternion do world_pose:
           q_down = (w=0, x=1, y=0, z=0)  → ROTATION_DOWNWARD_FACING
         A pose do sensor (3.14 rad em Z) gira 180° para que o feixe
         aponte para baixo (-Z no frame do link).
         Visual: mesh LW20 inclinado 90° (deitado, apontando para baixo).
    ================================================================ -->
    <!-- Visual do sensor físico LW20 (down) -->
    <link name="lw20_down_link">
      <pose relative_to="base_link">0 0 -0.079 0 1.5708 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000004</iyy><iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="lw20_down_visual">
        <geometry>
          <mesh><uri>model://LW20/meshes/LW20.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name="LidarDownModelJoint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_down_link</child>
    </joint>

    <!-- Link do sensor 1D LiDAR inferior. O GZBridge usa este nome para publicar orientation 25. -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='lidar' type='gpu_lidar'>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <!-- Rotação de 180° em Z para que o feixe aponte para -Z (baixo) -->
        <pose>0 0 0 3.14159 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min><max>100.0</max><resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="LidarDownSensorJoint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- ================================================================
         1D LiDAR — FRONT-FACING (gz_x500_lidar_front — airframe 4017)
         Este sensor usa um link/sensor com nomes distintos para não
         colidir com o "lidar_sensor_link/lidar" do down-facing.
         O GZBridge do UAVJamSim também subscreve este tópico e publica como
         distance_sensor forward-facing.
    ================================================================ -->
    <!-- Visual do sensor físico LW20 (front) -->
    <link name="lw20_front_link">
      <pose relative_to="base_link">.15 0 .01 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000004</iyy><iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="lw20_front_visual">
        <geometry>
          <mesh><uri>model://LW20/meshes/LW20.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name="LidarFrontModelJoint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_front_link</child>
    </joint>

    <!-- Link do sensor 1D front-facing (nome distinto do down) -->
    <link name="lidar_front_sensor_link">
      <pose relative_to="base_link">0.3 0 0.01 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='lidar_front' type='gpu_lidar'>
        <gz_frame_id>lidar_front_sensor_link</gz_frame_id>
        <!-- Rotação 90° em X para que o feixe aponte para +X (frente) -->
        <pose relative_to="base_link">.15 0 .01 1.5708 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min><max>100.0</max><resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="LidarFrontSensorJoint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_front_sensor_link</child>
    </joint>

    <!-- ================================================================
         GIMBAL FRONTAL (gz_x500_gimbal — airframe 4019)
         Inclui: cgo3_mount_link, braços vertical/horizontal e câmera CGO3.
         Pose: topo do drone (z=0.26 m), rotação de 180° em Z para
         orientar o gimbal para frente.
    ================================================================ -->
    <include merge='true'>
      <uri>model://gimbal</uri>
      <pose>0 0 0.26 0 0 3.14159</pose>
    </include>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>

  </model>
</sdf>